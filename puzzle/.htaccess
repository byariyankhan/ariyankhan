# ── Puzzle – Train Your Brain ──
# The game signs people in with Google, whose library loads from accounts.google.com, opens a frame there and
# injects its own <style>. That needs a wider Content-Security-Policy than the rest of the site, and this is
# the only folder that gets it: the game and its two legal pages, nothing else.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.gstatic.com https://*.googletagmanager.com https://*.google-analytics.com https://static.cloudflareinsights.com https://*.googlesyndication.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://accounts.google.com https://*.googleusercontent.com https://www.gstatic.com https://img.youtube.com https://i.ytimg.com https://*.google-analytics.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.g.doubleclick.net; frame-src https://accounts.google.com https://www.youtube.com https://drive.google.com https://www.facebook.com https://*.googlesyndication.com https://*.adtrafficquality.google; connect-src 'self' https://accounts.google.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://cloudflareinsights.com https://www.youtube.com https://*.googlesyndication.com https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
