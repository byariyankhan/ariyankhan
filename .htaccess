# ══════════════════════════════════════════════════
#  ariyankhan.com — Apache configuration
# ══════════════════════════════════════════════════

Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# ── /service/ is gone: every old address → one of the four main service pages, in one hop ──
#    Only the four main service pages at the root are service pages now. Everything that lived under
#    /service/ (the audience variants, the corporate and remote pages, the folder's own index) was
#    deleted and 301s to the main page it was a variant of: the one each named in its own
#    <service-profile service="…">. service/README.md lists the lot.
#    These come before the www and HTTPS rules on purpose: the target is written for the canonical host
#    (www. and youtube. stripped) and https, so even http://www.…/service/… is one hop, not three. The
#    query string carries over (the substitution has none of its own). Unknown /service/ paths stay a
#    plain 404: sending a URL that never existed to a page is a soft 404 in Google's eyes.
#    The files are gone; these rules are what still answers for them, so they stay.
RewriteCond %{HTTP_HOST} ^(?:www\.|youtube\.)?(.+)$ [NC]
RewriteRule ^service(?:/|$) - [E=SERVICE_HOST:%1]
RewriteRule ^service/?$                                                               https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/index\.(?:php|html)$                                             https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/corporate-video-editing\.html$                                   https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/remote-video-editor\.html$                                       https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-authors-and-speakers\.html$                     https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-coaches\.html$                                  https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-finance-and-investing-channels\.html$           https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-founders\.html$                                 https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-healthcare-professionals\.html$                 https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-podcasters\.html$                               https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-real-estate-agents\.html$                       https://%{ENV:SERVICE_HOST}/talking-head-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-business-documentary-channels\.html$            https://%{ENV:SERVICE_HOST}/documentary-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-faceless-youtube-channels\.html$                https://%{ENV:SERVICE_HOST}/documentary-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-nonprofit-organizations\.html$                  https://%{ENV:SERVICE_HOST}/documentary-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-true-crime-youtube-channels\.html$              https://%{ENV:SERVICE_HOST}/documentary-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-wildlife-and-nature-documentaries\.html$        https://%{ENV:SERVICE_HOST}/documentary-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-fitness-creators\.html$                         https://%{ENV:SERVICE_HOST}/short-form-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-social-media-promo-clips\.html$                 https://%{ENV:SERVICE_HOST}/short-form-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-economics-and-trade-explainer-channels\.html$   https://%{ENV:SERVICE_HOST}/map-animation-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-geography-and-country-explainer-channels\.html$ https://%{ENV:SERVICE_HOST}/map-animation-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-history-and-geopolitics-channels\.html$         https://%{ENV:SERVICE_HOST}/map-animation-video-editing.html [R=301,L,NE]
RewriteRule ^service/video-editor-for-military-history-channels\.html$                https://%{ENV:SERVICE_HOST}/map-animation-video-editing.html [R=301,L,NE]

# ── The two tools moved into folders of their own: /map-maker.html → /map-maker/, in one hop ──
#    Map Maker and AI Metadata Remover are their own products now, like /puzzle/: each folder holds the tool,
#    a How to use guide, About & FAQ and Privacy, with its own look and no site navigation. The old page, and
#    the bare folder name without its slash, go straight to the folder. Written for the canonical host and
#    https for the same reason as the /service/ rules above, so http://www.… is still one hop. A Map Maker
#    share link keeps working: its map lives after the #, which the browser carries across the redirect.
RewriteCond %{HTTP_HOST} ^(?:www\.|youtube\.)?(.+)$ [NC]
RewriteRule ^(?:map-maker|ai-metadata-remover)(?:\.html)?$ - [E=TOOL_HOST:%1]
RewriteRule ^map-maker(?:\.html)?$             https://%{ENV:TOOL_HOST}/map-maker/ [R=301,L,NE]
RewriteRule ^ai-metadata-remover(?:\.html)?$   https://%{ENV:TOOL_HOST}/ai-metadata-remover/ [R=301,L,NE]

# ── Redirect www to non-www (checked before HTTPS so http://www.
#    resolves in a single hop instead of http→https-www→https-apex) ──
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── /index.html → / (one canonical URL per page) ──
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ https://%{HTTP_HOST}/%1 [R=301,L,NE]

# ── Force HTTPS ──────────────────────────────────
#    Behind a TLS-terminating proxy (Caddy on the VPS, Cloudflare) Apache
#    itself only ever sees plain HTTP, so also trust X-Forwarded-Proto or
#    this loops forever.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── The game moved: /arrow-atlas.html → /puzzle/ ──
#    Permanent, and permanent it stays. Links to the old page are in shared results, in video
#    descriptions and in the start_url of every copy of the game somebody has installed; a 301 is what
#    keeps all three working and hands the search ranking to the new address. The fragment a share link
#    carries (#b-050, #m=ABCD) is re-appended by the browser, so a challenge link survives the hop.
#    The target is written in full, https and host and all, for the same reason the rules above it are:
#    behind a TLS-terminating proxy Apache only ever sees plain HTTP, so a bare path redirect answers
#    http:// and costs every old link a second hop.
RewriteRule ^arrow-atlas\.html$          https://%{HTTP_HOST}/puzzle/ [R=301,L,NE]
RewriteRule ^arrow-atlas-privacy\.html$  https://%{HTTP_HOST}/puzzle/privacy.html [R=301,L,NE]
RewriteRule ^arrow-atlas-terms\.html$    https://%{HTTP_HOST}/puzzle/terms.html [R=301,L,NE]

# ── /puzzle → /puzzle/ in one hop ──
#    /puzzle/ is the game's one address: its canonical, the sitemap, the manifest's scope. Left to itself,
#    mod_dir's DirectorySlash adds the slash, but behind the TLS-terminating proxy it answers http://…/puzzle/,
#    so the bare address cost two hops and one of them over plain HTTP. Written in full for the same reason
#    as the rules above. Not on the youtube subdomain, which has no game to send anybody to.
RewriteCond %{HTTP_HOST} !^youtube\. [NC]
RewriteRule ^puzzle$                     https://%{HTTP_HOST}/puzzle/ [R=301,L,NE]

# ── Never serve deploy/test tooling ──────────────
RedirectMatch 404 ^/(deploy|tests)(/|$)
RedirectMatch 404 ^/games/build-[a-z-]+\.mjs$
#    Markdown is the repository's own notes (README.md at the root, in service/, blog/, games/puzzle/, android/
#    and vendor/), not pages: a 404 on the web, however it is cased, while the files stay in git.
RedirectMatch 404 (?i)\.(md|markdown)$

# ── youtube.ariyankhan.com ───────────────────────
#    One container, two sites. The subdomain's document root is /youtube (the
#    channel smart link and a page per video); the main site never serves that
#    folder, so the same pages are not indexed twice. [END] stops the rewrite
#    engine outright, which is what keeps an internal rewrite from looping back
#    through these rules.
RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteRule ^youtube(/|$) - [R=404,END]

#    one canonical URL per page: no /index.php, no .php extension. Only pages that
#    really are in the folder redirect, so a stray .php elsewhere stays a plain 404.
RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteRule ^index\.(?:php|html)$ https://%{HTTP_HOST}/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteCond %{DOCUMENT_ROOT}/youtube/$1.php -f
RewriteRule ^(.+)\.php$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteRule ^$ youtube/index.php [END]

RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteCond %{DOCUMENT_ROOT}/youtube/$1 -f
RewriteRule ^(.+)$ youtube/$1 [END]

#    /spain, not /spain.php: the pages' own canonical URLs carry no extension
RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteCond %{DOCUMENT_ROOT}/youtube/$1.php -f
RewriteRule ^([^./]+)/?$ youtube/$1.php [END]

RewriteCond %{HTTP_HOST} ^youtube\. [NC]
RewriteRule ^ - [R=404,END]

#    and on the main site that folder is not a page at all
RewriteRule ^youtube(/|$) - [R=404,L]

## Missing paths: keep a real 404 status and hand off to /404.html
RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]


# ── Security headers ─────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # analytics.google.com is listed beside *.analytics.google.com on purpose: in CSP a wildcard covers the
  # subdomains of a host and not the host itself, and Analytics sends one of its two collect calls to the bare
  # name — which the browser refused, with the console saying so on every page load.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com https://static.cloudflareinsights.com https://*.googlesyndication.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://img.youtube.com https://i.ytimg.com https://*.google-analytics.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.g.doubleclick.net; frame-src https://www.youtube.com https://drive.google.com https://www.facebook.com https://*.googlesyndication.com https://*.adtrafficquality.google; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://cloudflareinsights.com https://www.youtube.com https://*.googlesyndication.com https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self'"
  # The game keeps its own, wider policy in puzzle/.htaccess: it is the only page that signs people in
  # with Google, and the folder that needs the exception is the folder that should carry it.
  # The channel pages on youtube.ariyankhan.com send their own security headers, and a stricter policy than
  # this one: nonces rather than 'unsafe-inline', frames denied outright. Two Content-Security-Policy headers
  # are enforced as the intersection of both and the other four would simply contradict each other, so the
  # subdomain drops these and lets the pages speak. Its static files keep nosniff and HSTS from above.
  <If "%{HTTP_HOST} =~ /^youtube\./i">
    Header always unset Content-Security-Policy
    Header always unset X-Frame-Options
    Header always unset Referrer-Policy
    Header always unset Permissions-Policy
  </If>
</IfModule>

# ── Gzip compression ─────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/webp
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff2
</IfModule>

# ── Browser caching ──────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # CSS & JS - long cache + immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML - no cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Map Maker country data - big, versioned by filename, never changes
  <FilesMatch "^countries-(110m|50m)\.json$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Service worker: browsers re-check it on every page load, so the edge must not pin it for a year
  <Files "piece-the-world-sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

# ── Protect local mail config ─────────────────────
<Files "mail-config.local.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# ── Protect Project Tracker database ──────────────
<FilesMatch "\.sqlite$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Hide server info ─────────────────────────────
ServerSignature Off
