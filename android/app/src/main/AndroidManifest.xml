<?xml version="1.0" encoding="utf-8"?>
<!-- One activity, because the app is one screen: the game.

     It is a WebView the app owns, not a Trusted Web Activity handed to Chrome. The reason is money, not
     taste: AdMob's H5 integration registers a WebView instance with the Mobile Ads SDK, and a Trusted Web
     Activity has no instance to register because the renderer is Chrome's. Play Billing points the same way.
     See MainActivity for the rest, and android/README.md for what the move cost.

     POST_NOTIFICATIONS is here for a reason the app can now use. The Push API does not exist in a WebView, so
     the game's web push never could work in the app; what delivers an invitation to a phone is Firebase Cloud
     Messaging, received by PuzzleMessagingService below. The permission is asked for at one moment only: when
     the player turns the switch on in Settings. Never on the way in. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- appCategory="game" is load-bearing. Android 16 ignores android:screenOrientation on any display
         600dp wide or over, so a tablet or an unfolded foldable would hand the game a landscape window
         whatever the activity below asked for. Games are the documented exception, and this is a game, so
         with the category declared the portrait lock still holds. The web side does not lean on it either:
         css/puzzle.css counter-rotates the board when the window comes up sideways, which covers both the
         user picking the per-app override today and Google retiring the exception later.

         enableOnBackInvokedCallback is what routes the back gesture through OnBackInvokedDispatcher, which is
         where MainActivity's OnBackPressedCallback listens. Without it the callback is never called on
         Android 13 and up and back would leave the game instead of walking its history. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false"
        android:theme="@style/Theme.App"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true">

        <!-- The Mobile Ads SDK reads both of these at startup.

             APPLICATION_ID is not optional and not lenient: absent or malformed and the SDK throws on launch,
             deliberately, so that it is found here rather than by a player. It is still Google's test id; see
             strings.xml.

             INTEGRATION_MANAGER is what makes this app's AdMob an H5 integration rather than a native one. It
             says: do not expect native ad views in this app, expect a WebView that will be registered, and
             serve the ads the game's own AdSense tag asks for from AdMob's demand instead of AdSense's. That
             is the whole reason the app owns its WebView. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />
        <meta-data
            android:name="com.google.android.gms.ads.INTEGRATION_MANAGER"
            android:value="webview" />

        <!-- Where a notification arrives. Firebase Cloud Messaging delivers to this service whether the game is
             open or not, and the service draws every notification itself: the server sends data, never a
             ready-made notification, so an invitation looks the same either way. Not exported; only Firebase's
             own delivery reaches it. -->
        <service
            android:name=".PuzzleMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase minting a token at startup would be Firebase being spoken to on behalf of a player who
             has turned nothing on. Off, until the switch is: MainActivity turns it on then, and off again. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- What the library itself would draw if a message ever arrived with a notification block instead
             of data. None of ours do, but a test message sent from the Firebase console does. The same icon
             and the same channel, so even that lands in the right place and not in a "Miscellaneous" channel
             of the library's own making. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_puzzle" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="invites" />

        <!-- configChanges is the difference between a rotation costing nothing and a rotation throwing the
             board away. Without it Android destroys and rebuilds the activity, and a rebuilt WebView starts
             the page again: saveState() restores a URL and a history list, never the running JavaScript. The
             game is locked to portrait, but a theme change, a font-size change and a foldable being opened
             are all configuration changes too.

             singleTask so an invitation link tapped in a chat window comes back to the game already running
             rather than stacking a second copy of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|keyboardHidden|keyboard|navigation|fontScale|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invitation links open the app rather than the browser. autoVerify makes Android check
                 assetlinks.json on the site, which is the same file and the same fingerprints as before. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- The game itself, and nothing else under /puzzle. A prefix would also claim
                     privacy.html and terms.html, and a reader who taps the privacy policy wants to read it,
                     not to be dropped into a puzzle. An exact path still catches every link the game hands
                     out — #m=CODE for an invitation, #b-<id> for a shared board, ?utm_source=android for its
                     own launch — because a fragment and a query are not part of the path. Both spellings,
                     since a link typed or pasted without the trailing slash is the same page. -->
                <data android:scheme="https" android:host="@string/host" android:path="/puzzle/" />
                <data android:scheme="https" android:host="@string/host" android:path="/puzzle" />
            </intent-filter>
        </activity>
    </application>
</manifest>
