<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Puzzle</string>
    <!-- The one URL this app exists to open. utm_source says where an install came from, the same way the
         installed PWA's start_url does. -->
    <string name="launch_url" translatable="false">https://ariyankhan.com/puzzle/?utm_source=android</string>
    <!-- The host the app is trusted on, used by the deep link filter. One place, so it cannot drift. -->
    <string name="host" translatable="false">ariyankhan.com</string>
    <!-- The first-run-with-no-network screen. After that the service worker has the game and this is
         unreachable. -->
    <string name="offline_title">No connection</string>
    <string name="offline_body">Puzzle needs the network the first time it opens. After that it plays offline.</string>
    <string name="offline_retry">Try again</string>
    <!-- The Web OAuth client, and deliberately the web one: Credential Manager is told this as its
         serverClientId, which makes it the audience of the ID token it returns — and the audience is exactly
         what the server compares against its own GOOGLE_CLIENT_ID. So the app signs in through the endpoint
         the browser already uses and the server needs no change at all.

         The Android client IDs are not here and are not needed in code. They exist in the same Cloud project
         so that Google can check the package name and signing certificate of whatever is asking; nothing
         references them.

         Not a secret. The site serves this same value from /api/puzzle/v1/auth/me to every visitor. -->
    <string name="google_web_client_id" translatable="false">83384024830-f7bt8g5amgo21e6pmonr4ssjrq02vhg4.apps.googleusercontent.com</string>

    <!-- The AdMob app, and not a secret: an app id ships inside every APK that uses it, which is why Google
         prints it on a page rather than behind one. The pairing publisher id is the same one AdSense uses, so
         the website and the app are one account.

         It has to be in the manifest at all because the Mobile Ads SDK reads it at startup and throws if it is
         missing or malformed — by design, so the mistake is found in development rather than in the store.

         Testing against it is where care is needed: an advertisement of your own that you click is invalid
         traffic, and invalid traffic costs the account. Put the phone in AdMob → Settings → Test devices
         before pressing anything, and it will serve test creatives through these same real ids. -->
    <string name="admob_app_id" translatable="false">ca-app-pub-1570944160084395~8956379298</string>

    <!-- The notification channels. Android lists these by name in the app's own notification settings, where
         a player can silence one kind and keep the other. -->
    <string name="notify_invites">Invitations</string>
    <string name="notify_invites_about">Somebody asking you to a match. The room waits minutes, not hours.</string>
    <string name="notify_league">League</string>
    <string name="notify_league_about">Where you finished, when the week\'s league pays out.</string>
    <string name="notify_reminders">Daily reminder</string>
    <string name="notify_reminders_about">A nudge at seven in the evening to play a board. Also a switch in the game\'s Settings.</string>
</resources>
