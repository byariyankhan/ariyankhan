<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Puzzle</string>
    <!-- The one URL this app exists to open. utm_source says where an install came from, the same way the
         installed PWA's start_url does. -->
    <string name="launch_url" translatable="false">https://ariyankhan.com/puzzle/?utm_source=android</string>
    <!-- The host the app is trusted on, used by the deep link filter. One place, so it cannot drift. -->
    <string name="host" translatable="false">ariyankhan.com</string>
    <!-- The first-run-with-no-network screen. After that the service worker has the game and this is
         unreachable. -->
    <string name="offline_title">No connection</string>
    <string name="offline_body">Puzzle needs the network the first time it opens. After that it plays offline.</string>
    <string name="offline_retry">Try again</string>
    <!-- The Web OAuth client, and deliberately the web one: Credential Manager is told this as its
         serverClientId, which makes it the audience of the ID token it returns — and the audience is exactly
         what the server compares against its own GOOGLE_CLIENT_ID. So the app signs in through the endpoint
         the browser already uses and the server needs no change at all.

         The Android client IDs are not here and are not needed in code. They exist in the same Cloud project
         so that Google can check the package name and signing certificate of whatever is asking; nothing
         references them.

         Not a secret. The site serves this same value from /api/puzzle/v1/auth/me to every visitor. -->
    <string name="google_web_client_id" translatable="false">83384024830-f7bt8g5amgo21e6pmonr4ssjrq02vhg4.apps.googleusercontent.com</string>

    <!-- ⚠️ STILL GOOGLE'S TEST APP ID. Replace with the real one before anything is uploaded to Play.
         AdMob → your app → App settings → App ID, and it looks like ca-app-pub-0000000000000000~0000000000.

         It has to be here at all because the Mobile Ads SDK reads it out of the manifest at startup and
         *crashes the app on launch* if it is missing or malformed — by design, so the mistake is found in
         development rather than in the store. Google's own test id is what that development is done against:
         clicking a real advertisement of your own is invalid traffic, and invalid traffic costs the account. -->
    <string name="admob_app_id" translatable="false">ca-app-pub-3940256099942544~3347511713</string>
</resources>
