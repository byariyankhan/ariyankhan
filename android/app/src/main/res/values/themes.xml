<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar and no title: the game draws its own. The window background is the splash colour so
         there is nothing to see between the tap and the splash. -->
    <style name="Theme.App" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
