<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView, and the offline screen over it.

     Both fill the whole window, bars included: Android 16 makes every window edge-to-edge with no way out, and
     the page is written for it (viewport-fit=cover, env(safe-area-inset-*) on all four edges), so it is the
     page that keeps the game clear of the clock and the navigation bar. The offline screen is the one piece of
     native UI, and MainActivity pads it by the insets itself.

     There is no splash view here any more. The splash is Android's own (Theme.App.Starting, installSplashScreen
     in MainActivity), held until the page has painted; it used to be an ImageView over both layers, faded out
     the first time the page committed a frame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- What a first run with no network gets. A WebView that fails its main frame paints nothing at all,
             and a blank app is both a bad first impression and the shape of app Play rejects under its
             minimum functionality policy. Once the service worker has a copy of the game this screen stops
             appearing, because the failure never reaches us. -->
        <LinearLayout
            android:id="@+id/offline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@color/paper"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_title"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/offline_body"
                android:textColor="@color/ink"
                android:alpha="0.7"
                android:textSize="15sp"
                android:gravity="center" />

            <Button
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/offline_retry" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
