<?xml version="1.0" encoding="utf-8"?>
<!-- What the resource shrinker must not take.

     This list was written after a release build dropped @drawable/splash and the app died on launch with
     Resources.NotFoundException — "Puzzle keeps stopping", on every open, only in the shipped build. The cause
     was that the Trusted Web Activity named the splash from a manifest <meta-data android:resource="...">,
     and shrinkResources does not walk those.

     The shell names it from a layout instead, which the shrinker does follow, so this file is now a belt to
     the layout's braces rather than the only thing holding the splash in. It stays because the failure it
     prevents is invisible in debug builds and fatal in release ones, and because the colours below are still
     partly referenced from places the walk does not reach. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/splash,@color/paper,@color/ink" />
