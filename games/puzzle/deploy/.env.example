# Puzzle – Train Your Brain — deployment settings.
#
#   cp .env.example .env    then fill in the two passwords and the Google client id.
#
# The names here still say PUZZLE_, which is what the game was called before it was renamed. They are
# kept on purpose: this file sits on the host, beside two passwords, and the compose file reads these names
# out of it. Renaming them means editing that file on the box, which is a thing to do deliberately and not as
# a side effect of a rename. Everything the container sees is PUZZLE_*, and the service reads either.
#
# Never commit .env. The passwords below are the only secrets this project has; everything else is a choice,
# not a credential. Generate each one with:  openssl rand -base64 32

# ── Secrets ──
PUZZLE_PG_PASSWORD=
PUZZLE_REDIS_PASSWORD=
# From the Google Cloud console. Empty means no sign-in is offered, and the single-player game still works.
GOOGLE_CLIENT_ID=

# ── Where things listen ──
# The API binds to 127.0.0.1 on this port; the host nginx is the only way in. PostgreSQL and Redis publish
# nothing at all.
PUZZLE_PORT=8760

# ── Which image to run ──
# Built and pushed by .github/workflows/arrow-atlas-api.yml on every push to main.
PUZZLE_IMAGE=ghcr.io/byariyankhan/arrow-atlas-api:main
PUZZLE_VERSION=main

# ── Database ──
PUZZLE_PG_DATABASE=arrow_atlas
PUZZLE_PG_USER=arrow_atlas

# ── Redis ──
# Every key this product writes starts with this, so a second game can never collide with Arrow Atlas.
# Changing this on a running box orphans what Redis holds — who is online, rate-limit counters,
# countdown mirrors — all of which the game can afford to lose.
PUZZLE_REDIS_PREFIX=puzzle:
PUZZLE_REDIS_MAXMEMORY=256mb

# ── Backups ──
# Where the dumps land on the host, outside the live PostgreSQL volume. Create it first:
#   mkdir -p /var/backups/arrow-atlas
PUZZLE_BACKUP_HOST_DIR=/var/backups/arrow-atlas
PUZZLE_BACKUP_KEEP_DAYS=14
PUZZLE_BACKUP_AT_HOUR=3

# ── The web client ──
# Leave empty while the game is served from ariyankhan.com: the client uses its own origin. When Arrow Atlas
# moves to a host of its own, list the origins allowed to call the API with credentials, e.g.
#   PUZZLE_ALLOWED_ORIGINS=https://arrowatlas.com,https://www.arrowatlas.com
PUZZLE_ALLOWED_ORIGINS=

# ── Behaviour ──
PUZZLE_COOKIE_SECURE=true
PUZZLE_LOG_LEVEL=info
# Multiplies every rate limit. Production leaves this at 1; raise it only to load-test the service itself.
PUZZLE_RATE_MULTIPLIER=1
